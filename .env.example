# Web dashboard data source mode:
# - bucket_compute (default): compute report live from GCS summary.csv files.
# - remote: read prebuilt report JSON from RESULTS_REPORT_URL.
# - local: read local results/model-comparison-report.json.
# - auto: try bucket_compute -> remote -> local.
RESULTS_SOURCE_MODE=bucket_compute

# Bucket source for bucket_compute (/api/results-report): lists summary.csv under this prefix.
RESULTS_BUCKET_NAME=levante-bench
RESULTS_BUCKET_PREFIX=results/v1

# KL / AgeEq CSVs live outside the per-model tree unless you publish them under v1.
KL_REPORT_BUCKET_PREFIX=results/comparison
MODEL_AGE_EQ_BUCKET_PREFIX=results/comparison
MODEL_AGE_EQ_ACC_BUCKET_PREFIX=results/comparison

# Human baseline + parser report paths (do not inherit RESULTS_BUCKET_PREFIX).
HUMAN_AGE_BUCKET_PREFIX=results
PARSER_GLITCH_BUCKET_PREFIX=results

# Optional remote prebuilt report URL (used in remote/auto mode).
RESULTS_REPORT_URL=
